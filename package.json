{
  "name": "onsketch",
  "private": true,
  "type": "module",
  "description": "Browser-based parametric 2D sketcher. No build step: app/ is served as static ES modules.",
  "scripts": {
    "serve": "python3 -m http.server 8080",
    "test": "node scripts/stamp.mjs --check && node --test \"tests/unit/*.test.js\"",
    "test:e2e": "node tests/smoke.e2e.mjs",
    "lint": "eslint app/src tests",
    "stamp": "node scripts/stamp.mjs",
    "test:mobile": "node tests/mobile.e2e.mjs",
    "test:cloud": "node tests/cloud.e2e.mjs",
    "test:ink": "node tests/ink.e2e.mjs",
    "test:arrow": "node tests/arrow.e2e.mjs",
    "test:display": "node tests/display.e2e.mjs",
    "test:image": "node tests/image.e2e.mjs",
    "test:clipboard": "node tests/clipboard.e2e.mjs",
    "test:linedim": "node tests/linedim.e2e.mjs",
    "test:layers": "node tests/layers.e2e.mjs",
    "test:nosnap": "node tests/nosnap.e2e.mjs",
    "test:pattern": "node tests/pattern.e2e.mjs",
    "test:scissors": "node tests/scissors.e2e.mjs",
    "test:curve": "node tests/curve.e2e.mjs",
    "test:relmenu": "node tests/relmenu.e2e.mjs",
    "test:collapse": "node tests/collapse.e2e.mjs",
    "test:export": "node tests/export.e2e.mjs",
    "test:tour": "node tests/tour.e2e.mjs",
    "test:formula": "node tests/formula.e2e.mjs",
    "test:units": "node tests/units.e2e.mjs",
    "test:axis": "node tests/axis.e2e.mjs",
    "test:patform": "node tests/patform.e2e.mjs",
    "test:ctxmenu": "node tests/ctxmenu.e2e.mjs",
    "test:sizes": "node tests/sizes.e2e.mjs"
  },
  "devDependencies": {
    "eslint": "^9.39.0",
    "globals": "^15.15.0"
  }
}
